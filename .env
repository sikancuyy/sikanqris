TELEGRAM_BOT_TOKEN=8911047128:AAGLtv7UEndkb2BYPIxioGVT7WqnzLFXD20
TELEGRAM_ADMIN_ID=8451880009

# ==========================================
# METODE INTEGRASI QRIS GOPAY MERCHANT
# ==========================================
# Pilihan mode:
# 1. GOPAY_STATIC   : Mengonversi QRIS Statis GoPay Merchant (GoBiz) menjadi QRIS Dinamis ber-nominal (Sangat mudah & praktis).
# 2. MIDTRANS_GOPAY : Menggunakan API resmi Midtrans Core API (GoTo / GoPay).
# 3. GENERIC_API    : Menggunakan endpoint REST API eksternal.
QRIS_MODE=GOPAY_STATIC
QRIS_FRAME_PATH=bqr.png

# ------------------------------------------
# JIKA MENGGUNAKAN MODE: GOPAY_STATIC
# ------------------------------------------
# Masukkan teks/string mentah dari QRIS GoPay Merchant Anda.
# Cara mendapatkan: Scan QRIS GoPay / GoBiz Anda menggunakan aplikasi QR Scanner di HP atau Google Lens.
# Contoh string: 00020101021126580014ID.GO-JEK.WWW...5802ID...6304ABCD
GOPAY_QRIS_STATIC_STRING=00020101021126610014COM.GO-JEK.WWW01189360091434158140490210G4158140490303UMI51440014ID.CO.QRIS.WWW0215ID10254557413020303UMI5204899953033605802ID5925RAHMAT HAIKAL, Desain & K6010ACEH UTARA61052439462070703A0163047973

# ------------------------------------------
# JIKA MENGGUNAKAN MODE: MIDTRANS_GOPAY
# ------------------------------------------
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# ------------------------------------------
# JIKA MENGGUNAKAN MODE: GENERIC_API
# ------------------------------------------
QRIS_API_URL=
QRIS_API_KEY=
