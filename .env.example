# ==========================================
# KONFIGURASI BOT TELEGRAM
# ==========================================
TELEGRAM_BOT_TOKEN=8911047128:AAGLtv7UEndkb2BYPIxioGVT7WqnzLFXD20
TELEGRAM_ADMIN_ID=8451880009

# ==========================================
# METODE INTEGRASI QRIS GOPAY MERCHANT
# ==========================================
# Pilihan mode:
# 1. GOPAY_STATIC   : Mengonversi QRIS Statis GoPay Merchant (GoBiz) menjadi QRIS Dinamis ber-nominal (Direkomendasikan jika punya sticker/QRIS GoBiz).
# 2. MIDTRANS_GOPAY : Menggunakan API resmi Midtrans Core API (GoTo / GoPay Payment Gateway).
# 3. GENERIC_API    : Menggunakan endpoint REST API pihak ketiga.
QRIS_MODE=GOPAY_STATIC
QRIS_FRAME_PATH=bqr.png

# ------------------------------------------
# JIKA MENGGUNAKAN MODE: GOPAY_STATIC
# ------------------------------------------
# Masukkan teks/string mentah dari QRIS GoPay Merchant Anda.
# Cara mendapatkan: Scan QRIS GoPay / GoBiz Anda menggunakan aplikasi QR Scanner di HP atau Google Lens.
# String diawali dengan "000201010211..."
GOPAY_QRIS_STATIC_STRING=

# ------------------------------------------
# JIKA MENGGUNAKAN MODE: MIDTRANS_GOPAY
# ------------------------------------------
# Midtrans adalah payment gateway resmi GoPay / GoTo.
# Dapatkan Server Key di Dashboard Midtrans -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# ------------------------------------------
# JIKA MENGGUNAKAN MODE: GENERIC_API
# ------------------------------------------
QRIS_API_URL=
QRIS_API_KEY=
